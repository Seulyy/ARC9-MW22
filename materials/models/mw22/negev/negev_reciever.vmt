"VertexLitGeneric"
{
    "$basetexture" "models\mw22\negev\negev_reciever_rgb"
    "$bumpmap" "models\mw22\negev\negev_reciever_n"
    "$phongexponenttexture" "models\mw22\negev\negev_reciever_e"

    /////////////////
    "$color2" "[1 1 1]"                                     //do not touch this
    "$blendtintbybasealpha" "1"                             //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "env_cubemap"
    "$envmaptint" "[0.11 0.11 0.11]"

    "$detailblendmode" "4"
    "$detailblendfactor" "0.7"

    "Proxies"
     {
        "Arc9EnvMapTint"
        {
            "min" "0"
            "max" "0.2"
            "color" "[0.11 0.11 0.11]"
        }
        "CustomCamo" 
        {
	"camoTexture" $detail
	"camoScale" $detailscale
	"blend" $detailblendfactor
	"color2" "[0.8 0.8 0.8]"
        }
     }
}