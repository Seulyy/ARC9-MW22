"VertexLitGeneric"
{
    "$basetexture" "models\mw22\lachman556\lachman_stock_rgb"
    "$bumpmap" "models\mw22\lachman556\lachman_stock_n"
    "$phongexponenttexture" "models\mw22\lachman556\lachman_stock_e"

    /////////////////
    "$color2" "[1 1 1]"                                     //do not touch this
    "$blendtintbybasealpha" "1"                             //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "env_cubemap"
    "$envmaptint" "[0.098 0.098 0.098]"
    "$envmapfresnel"			".25"
    "$envmapcoefficient"		"[0.39 0.39 0.39]"                  

    "$detailblendmode" "4"
    "$detailblendfactor" "0.7"

     "Proxies"
     {
        "Arc9EnvMapTint"
        {
            "min" "0"
            "max" "0.2"
            "color" "[0.098 0.098 0.098]"
        }
        "CustomCamo" 
        {
	"camoTexture" $detail
	"camoScale" $detailscale
	"blend" $detailblendfactor
	"color2" "[0.8 0.8 0.8]"
        }
     }
}